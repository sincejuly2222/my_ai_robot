# 服务端口
PORT=3001

# LLM 提供商（默认 openai，走 OpenAI 兼容协议，DeepSeek 等多数服务也兼容）
LLM_PROVIDER=openai

# 你的 API Key（留空时，/api/chat 会返回友好提示，不会崩溃）
LLM_API_KEY=

# 模型名（按你的提供商填写，例如 gpt-4o-mini / deepseek-v4-flash）
LLM_MODEL=gpt-4o-mini

# 接口地址（可选；DeepSeek 填 https://api.deepseek.com/v1）
LLM_BASE_URL=

# 数据库（本地 MySQL 5.7）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_user
